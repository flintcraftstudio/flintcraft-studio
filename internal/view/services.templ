package view

import "github.com/firefly-software-mt/standard-template/internal/structdata"

templ ServicesPage() {
	@Page(PageMeta{
		Title:             "Website Design, Hosting and Care",
		Description:       "Website design, copywriting, SEO, hosting and care from a Helena studio. Pay once for the build, own the site, month-to-month after. Shaped with intent.",
		SocialDescription: "Pay for the build. Own the site. Month-to-month hosting and care after launch.",
		ActivePath:        "/services",
	}, servicesContent())
}

templ servicesContent() {
	@structdata.Script(faqLD(ServicesFAQ))
	<!-- Hero -->
	<section class="bg-fc-chalk py-20 sm:py-28">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			@eyebrow("Services")
			<h1 class="max-w-2xl font-display text-h1-display font-normal text-fc-obsidian">
				One relationship. <em class="italic text-fc-ember-deep">Everything handled.</em>
			</h1>
			<p class="mt-6 max-w-xl text-body text-fc-flint">
				For businesses that have earned their reputation and are ready for a website that reflects it.
			</p>
		</div>
	</section>

	<!-- ICP Statement -->
	<section class="border-y border-fc-ash bg-white py-16 sm:py-20">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div data-reveal class="max-w-2xl">
				@eyebrow("Who this is for")
				<div class="mt-4 space-y-4 text-body text-fc-flint">
					<p>
						You've done the hard part. You built something real, earned real customers, and proven the business works. Your website is the one thing you never got right — or the one thing you built when you were still figuring everything out.
					</p>
					<p>
						FlintCraft takes what you've built and shapes it into something worthy of it. A website that reflects your reputation, converts the right customers, and stays sharp without you having to think about it.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Capabilities -->
	<section class="bg-fc-obsidian py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div data-reveal>
				@eyebrowDark("What we do")
			</div>
			<div data-reveal style="transition-delay: 120ms" class="mt-8 grid gap-10 sm:grid-cols-2">
				@capabilityCard(
					"A site that reflects where you actually are.",
					"Not where you were when you started. Custom designed, custom built, no templates. When someone finds you online it should feel like the same business they hear about from a referral.",
				)
				@capabilityCard(
					"Copy that does the selling.",
					"We write it. You verify it. Most owners don't have time to stare at a blank page — so we don't ask you to. We bring something finished, you tell us what to change.",
				)
				@capabilityCard(
					"Built to get found.",
					"Every site we build includes SEO foundations, Google Business Profile setup and optimization, and copy written for the markets you actually serve. We diagnose the right visibility strategy for your business — local or regional — and build accordingly.",
				)
				@capabilityCard(
					"We watch what's working and adjust.",
					"After launch we track what's converting and tailor your content around it. If one service is pulling leads and another isn't, we shift. Your site stays aligned with where your business actually makes money.",
				)
				@capabilityCard(
					"Hosting, maintenance, and updates — handled.",
					"Your site lives on our infrastructure. Security, performance, and uptime are our problem. When something needs updating — new service, new photo, new hours — you call us directly. Not a ticket queue.",
				)
				@capabilityCard(
					"One person to call. Always.",
					"You'll know who built your site and you'll have their number. That doesn't change after launch.",
				)
			</div>
		</div>
	</section>

	<!-- Paid visibility callout -->
	<section class="border-y border-fc-ash bg-white py-12 sm:py-16">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div data-reveal class="max-w-2xl">
				@eyebrow("Paid visibility")
				<p class="mt-4 text-body text-fc-flint">
					Some clients need more than organic reach. Google Ads and Facebook campaigns are available as a separate engagement — scoped to your market and managed by the same people who built the site.
				</p>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="bg-fc-chalk py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div data-reveal class="max-w-2xl">
				@eyebrow("What it costs")
				<h2 class="font-display text-h2-display font-normal text-fc-obsidian">
					Straightforward pricing. No surprises.
				</h2>
				<div class="mt-8 space-y-4 text-body text-fc-flint">
					<p>
						<strong class="font-medium text-fc-obsidian">The build:</strong> most sites run $1,500–$3,000, one time, depending on page count, copywriting and how much content we're moving. Pay in full or in monthly installments.
					</p>
					<p>
						<strong class="font-medium text-fc-obsidian">Hosting and care:</strong> $150–$500 a month, starting after launch. That covers hosting, security, backups, maintenance and a real person to call. Plans with unlimited edits cover the everyday changes: text, photos, hours, new work for your portfolio.
					</p>
					<p>
						You get a written proposal with exact numbers before anything is signed.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Commitment -->
	<section class="bg-fc-obsidian py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div data-reveal class="max-w-2xl">
				@eyebrowDark("How the relationship works")
				<h2 class="font-display text-h2-display font-normal text-fc-chalk">
					Pay for the build. Own the site.
				</h2>
				<div class="mt-8 space-y-4 text-body text-fc-ash">
					<p>
						Your website is a one-time build fee. Pay it up front and the site is yours from day one. Or spread it over three or six months; it costs a little more, since we carry the balance. Either way, once the build is paid off, the site is yours.
					</p>
					<p>
						After launch, hosting and care are month-to-month. No long contract. Thirty days' notice ends it, and we hand over your site files. You never have to stay because you're stuck. You stay because it's worth it.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="bg-fc-chalk py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			@eyebrow("Common questions")
			<div data-reveal class="mt-8 max-w-2xl space-y-8">
				for _, f := range ServicesFAQ {
					@servicesFaqEntry(f)
				}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="bg-white py-20 sm:py-24">
		<div data-reveal class="mx-auto max-w-content px-6 text-center lg:px-8">
			<h2 class="font-display text-h2-display font-normal text-fc-obsidian">
				Not sure if we're the right fit?
			</h2>
			<p class="mx-auto mt-4 max-w-md text-body text-fc-flint">
				Write and describe what you're working on. We'll tell you straight.
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a
					href="/contact"
					class="rounded-[3px] bg-fc-ember-deep px-[22px] py-[10px] text-ui font-medium uppercase text-fc-chalk transition hover:brightness-90 active:scale-[0.97]"
				>
					Start a project
				</a>
				<a
					href="/work"
					class="border-b-[1.5px] border-fc-ember-deep px-0 py-[10px] text-ui font-medium uppercase text-fc-ember-deep transition hover:brightness-110 active:scale-[0.98]"
				>
					See our work &rarr;
				</a>
			</div>
		</div>
	</section>
}

templ capabilityCard(headline, body string) {
	<div class="rounded-[6px] border border-fc-flint bg-fc-flint p-7">
		<h3 class="mb-3 font-display text-h4-display font-normal text-fc-chalk">{ headline }</h3>
		<p class="text-body-sm text-fc-ash">{ body }</p>
	</div>
}

templ servicesFaqEntry(f FAQEntry) {
	<details class="group border-t border-fc-ash pt-6">
		<summary class="flex cursor-pointer items-center justify-between font-display text-h4-display font-normal text-fc-obsidian">
			{ f.Q }
			<span class="ml-4 text-fc-slate transition group-open:rotate-45">+</span>
		</summary>
		<div class="mt-4 space-y-3 text-body-sm text-fc-flint">
			for _, para := range f.A {
				<p>
					if para.Lead != "" {
						<strong class="font-medium text-fc-obsidian">{ para.Lead }</strong>
						if para.Text != "" {
							{ " " }
						}
					}
					{ para.Text }
				</p>
			}
		</div>
	</details>
}
