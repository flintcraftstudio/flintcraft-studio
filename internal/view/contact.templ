package view

templ ContactPage(errors map[string]string, values map[string]string, success bool) {
	@Page(PageMeta{
		Title:             "Start a Website Project",
		Description:       "Tell us about your business and your current website. Logan or Jaden will reply by the end of the next business day with a few notes on your site.",
		SocialDescription: "No pitch, no deck. Tell us what you're working on.",
		ActivePath:        "/contact",
	}, contactContent(errors, values, success))
}

templ contactContent(errors map[string]string, values map[string]string, success bool) {
	<section class="bg-fc-chalk py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div class="grid gap-16 lg:grid-cols-2">
				<!-- Left: intro -->
				<div>
					@eyebrow("Start a project")
					<h1 class="font-display text-h1-display font-normal text-fc-obsidian">
						<em class="italic">Let's find out if we're the right fit.</em>
					</h1>
					<p class="mt-6 max-w-md text-body text-fc-flint">
						No pitch, no deck. Tell us what you're working on — we'll take a look at your current setup and come to the first conversation prepared.
					</p>
					<!-- Contact info -->
					<div class="mt-10 space-y-3 text-body-sm text-fc-slate">
						<p>Prefer to call? <a href="tel:+14068719875" class="text-fc-ember-deep underline underline-offset-2 transition hover:brightness-110">{ Phone }</a></p>
						<p>Or email: <a href={ templ.SafeURL("mailto:" + Email) } class="text-fc-ember-deep underline underline-offset-2 transition hover:brightness-110">{ Email }</a></p>
						<p>We're based in Helena, Montana. Logan or Jaden will reply by the end of the next business day (Mountain Time) with a few notes on your current site.</p>
					</div>
				</div>
				<!-- Right: form -->
				<div>
					@ContactForm(errors, values, success)
				</div>
			</div>
		</div>
	</section>
}

templ ContactForm(errors map[string]string, values map[string]string, success bool) {
	<!-- After the swap, focus the thank-you or the error summary so keyboard and
	     screen reader users land on (and hear) the result. -->
	<form
		hx-post="/contact"
		hx-swap="outerHTML"
		hx-on::after-settle="(document.getElementById('contact-sent') || document.getElementById('contact-errsum'))?.focus()"
		class="space-y-5"
	>
		if success {
			<div id="contact-sent" role="status" tabindex="-1" class="rounded-[6px] border-l-[2.5px] border-fc-ember-deep bg-white p-6">
				<p class="text-body font-normal text-fc-obsidian">
					Got it. We'll look at your current site first, then reply by end of the next business day. Need us sooner? Call <a href="tel:+14068719875" class="text-fc-ember-deep underline underline-offset-2 transition hover:brightness-110">{ Phone }</a>.
				</p>
			</div>
		} else {
			<!-- Referral source: carried through to the email so we know a lead came via an industry demo -->
			if values["ref"] != "" {
				<input type="hidden" name="ref" value={ values["ref"] }/>
			}
			if ReferralLabel(values["ref"]) != "" {
				<div class="rounded-[6px] border-l-[2.5px] border-fc-ember-deep bg-white px-5 py-3">
					<p class="text-body-sm text-fc-flint">
						You're coming from { ReferralLabel(values["ref"]) }. Tell us about your practice and we'll show you what we'd build.
					</p>
				</div>
			}
			<p class="text-body-sm text-fc-slate"><span aria-hidden="true" class="text-fc-ember-deep">*</span> required</p>
			if len(errors) > 0 {
				<div id="contact-errsum" role="alert" tabindex="-1" class="rounded-[3px] border border-red-300 bg-red-50 p-4">
					if errors["form"] != "" {
						<p class="text-body-sm text-red-700">{ errors["form"] }</p>
					} else {
						<p class="text-body-sm font-medium text-red-700">Please fix the following:</p>
						<ul class="mt-2 list-disc space-y-1 pl-5 text-body-sm text-red-700">
							for _, f := range contactErrorFields {
								if errors[f] != "" {
									<li><a href={ templ.SafeURL("#" + f) } class="underline underline-offset-2">{ errors[f] }</a></li>
								}
							}
						</ul>
					}
				</div>
			}
			<div>
				<label for="name" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">Name <span aria-hidden="true" class="text-fc-ember-deep">*</span></label>
				<input
					type="text"
					id="name"
					name="name"
					required
					autocomplete="name"
					value={ values["name"] }
					if errors["name"] != "" {
						aria-invalid="true"
						aria-describedby="name-error"
					}
					class="w-full rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] text-fc-obsidian placeholder-fc-slate outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
					placeholder="Your name"
				/>
				if errors["name"] != "" {
					<p id="name-error" class="mt-1 text-eyebrow tracking-normal text-red-600">{ errors["name"] }</p>
				}
			</div>
			<div>
				<label for="business" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">Business name</label>
				<input
					type="text"
					id="business"
					name="business"
					value={ values["business"] }
					class="w-full rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] text-fc-obsidian placeholder-fc-slate outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
					placeholder="Your business"
				/>
			</div>
			<div>
				<label for="email" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">Email <span aria-hidden="true" class="text-fc-ember-deep">*</span></label>
				<input
					type="email"
					id="email"
					name="email"
					required
					autocomplete="email"
					value={ values["email"] }
					if errors["email"] != "" {
						aria-invalid="true"
						aria-describedby="email-error"
					}
					class="w-full rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] text-fc-obsidian placeholder-fc-slate outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
					placeholder="you@example.com"
				/>
				if errors["email"] != "" {
					<p id="email-error" class="mt-1 text-eyebrow tracking-normal text-red-600">{ errors["email"] }</p>
				}
			</div>
			<div>
				<label for="phone" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">
					Phone <span class="normal-case tracking-normal text-fc-slate">(optional)</span>
				</label>
				<input
					type="tel"
					id="phone"
					name="phone"
					value={ values["phone"] }
					class="w-full rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] text-fc-obsidian placeholder-fc-slate outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
					placeholder="(555) 555-5555"
				/>
			</div>
			<div>
				<label for="website" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">
					Current website URL <span class="normal-case tracking-normal text-fc-slate">(leave blank if you don't have one)</span>
				</label>
				<input
					type="text"
					id="website"
					name="website"
					value={ values["website"] }
					class="w-full rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] text-fc-obsidian placeholder-fc-slate outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
					placeholder="https://example.com"
				/>
			</div>
			<div>
				<label for="message" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">What's frustrating you about your current setup?&nbsp;<span aria-hidden="true" class="text-fc-ember-deep">*</span></label>
				<textarea
					id="message"
					name="message"
					required
					rows="5"
					if errors["message"] != "" {
						aria-invalid="true"
						aria-describedby="message-error"
					}
					class="w-full resize-y rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] leading-[1.6] text-fc-obsidian placeholder-fc-slate outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
					placeholder="For example: customers can't find our hours, the site looks dated, we can't update it ourselves."
				>{ values["message"] }</textarea>
				if errors["message"] != "" {
					<p id="message-error" class="mt-1 text-eyebrow tracking-normal text-red-600">{ errors["message"] }</p>
				}
			</div>
			<div>
				<label for="timeline" class="mb-1.5 block text-eyebrow font-medium uppercase tracking-[0.06em] text-fc-slate">
					When are you hoping to launch? <span class="normal-case tracking-normal text-fc-slate">(optional)</span>
				</label>
				<select
					id="timeline"
					name="timeline"
					class="w-full rounded-[3px] border border-fc-ash bg-fc-chalk px-[14px] py-[10px] text-[16px] text-fc-obsidian outline-none transition focus:border-fc-ember-deep focus:shadow-[0_0_0_2px_rgba(168,90,20,0.12)]"
				>
					<option value="">Choose one</option>
					for _, opt := range TimelineOptions {
						<option value={ opt } selected?={ values["timeline"] == opt }>{ opt }</option>
					}
				</select>
			</div>
			if TurnstileSiteKey != "" {
				<div class="cf-turnstile" data-sitekey={ TurnstileSiteKey } data-theme="light"></div>
			}
			<button
				type="submit"
				class="rounded-[3px] bg-fc-ember-deep px-[22px] py-[10px] text-ui font-medium uppercase text-fc-chalk transition hover:brightness-90 active:scale-[0.97]"
			>
				Send it
			</button>
			<p class="text-body-sm text-fc-slate">
				We only use this to reply to you. <a href="/privacy" class="text-fc-ember-deep underline transition hover:brightness-110">Privacy</a>
			</p>
		}
	</form>
}
