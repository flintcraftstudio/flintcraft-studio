package view

templ ProjectPage(p Project) {
	@Page(PageMeta{
		Title:         p.Client,
		Description:   p.Subtitle,
		Image:         p.Screenshot,
		ActivePath:    "/work",
		CanonicalPath: "/work/" + p.Slug,
	}, projectContent(p))
}

templ redesignPanel(label, src, caption, alt string, current bool) {
	<div>
		<div class="mb-3 flex items-center gap-3">
			if current {
				<span class="text-eyebrow font-medium uppercase text-fc-ember-deep">{ label }</span>
				<span class="h-px flex-1 bg-fc-ember-deep/40"></span>
			} else {
				<span class="text-eyebrow font-medium uppercase text-fc-slate">{ label }</span>
				<span class="h-px flex-1 bg-fc-ash"></span>
			}
		</div>
		<div class="overflow-hidden rounded-[6px] border border-fc-ash bg-fc-chalk">
			<img
				src={ src }
				alt={ alt }
				width="800"
				height="1067"
				loading="lazy"
				class="block w-full"
			/>
		</div>
		<p class="mt-4 text-body-sm text-fc-flint">{ caption }</p>
	</div>
}

templ projectContent(p Project) {
	<!-- Hero -->
	<section class="bg-fc-chalk py-20 sm:py-28">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<a
				href="/work"
				class="mb-8 inline-flex items-center text-ui uppercase text-fc-slate transition hover:text-fc-obsidian"
			>
				&larr; Back to work
			</a>
			@eyebrow("Field report")
			<h1 class="max-w-3xl font-display text-h1-display font-normal text-fc-obsidian">
				{ p.Title }
			</h1>
			<p class="mt-6 max-w-xl text-body text-fc-flint">
				{ p.Subtitle }
			</p>
		</div>
	</section>

	<!-- Meta -->
	<section class="border-y border-fc-ash bg-white">
		<div class="mx-auto flex max-w-content flex-wrap items-center gap-4 px-6 py-5 lg:px-8">
			<span class="text-eyebrow font-medium uppercase text-fc-obsidian">{ p.Client }</span>
			<span class="text-eyebrow tracking-normal text-fc-slate">{ p.Location }</span>
			for _, tag := range p.Tags {
				<span class="rounded-[20px] border border-fc-ash px-[8px] py-[2px] text-eyebrow uppercase tracking-[0.08em] text-fc-slate">
					{ tag }
				</span>
			}
		</div>
	</section>

	<!-- Screenshots -->
	if p.Screenshot != "" {
		<section class="bg-fc-chalk py-16 sm:py-20">
			<div class="mx-auto max-w-content px-6 lg:px-8">
				<div class="flex flex-col items-start gap-8 sm:flex-row">
					<!-- Desktop -->
					<div class="flex-1">
						<div class="overflow-hidden rounded-[6px] border border-fc-ash">
							<div class="flex items-center gap-[5px] border-b border-fc-ash bg-white px-3 py-2">
								<span class="h-[7px] w-[7px] rounded-full bg-fc-ash"></span>
								<span class="h-[7px] w-[7px] rounded-full bg-fc-ash"></span>
								<span class="h-[7px] w-[7px] rounded-full bg-fc-ash"></span>
							</div>
							if p.HeroVideo != "" {
								<video
									autoplay
									muted
									loop
									playsinline
									preload="metadata"
									poster={ p.Screenshot }
									class="block w-full"
									aria-label={ p.Client + " website — hero video" }
								>
									if p.HeroVideoWebm != "" {
										<source src={ p.HeroVideoWebm } type="video/webm"/>
									}
									<source src={ p.HeroVideo } type="video/mp4"/>
									<img
										src={ p.Screenshot }
										alt={ p.Client + " website — desktop view" }
										class="w-full"
									/>
								</video>
							} else {
								<img
									src={ p.Screenshot }
									alt={ p.Client + " website — desktop view" }
									width="800"
									height="542"
									class="w-full"
								/>
							}
						</div>
					</div>
					<!-- Mobile -->
					if p.ScreenshotMobile != "" {
						<div class="w-[180px] shrink-0">
							<div class="overflow-hidden rounded-[12px] border-2 border-fc-ash">
								<img
									src={ p.ScreenshotMobile }
									alt={ p.Client + " website — mobile view" }
									width="400"
									height="866"
									class="w-full"
								/>
							</div>
						</div>
					}
				</div>
				if p.LiveURL != "" {
					<div class="mt-8 rounded-[6px] border border-fc-ash bg-white px-6 py-4">
						<p class="text-body-sm text-fc-obsidian">
							<span class="font-medium">This site is live.</span> See the real thing — not just a screenshot.
							<a
								href={ templ.SafeURL(p.LiveURL) }
								target="_blank"
								rel="noopener"
								class="ml-2 text-fc-ember-deep transition hover:brightness-110"
							>
								Visit { p.Client } &nearr;
							</a>
						</p>
					</div>
				}
			</div>
		</section>
	}

	<!-- Before / after -->
	if p.Redesign != nil {
		<section class="border-t border-fc-ash bg-white py-20 sm:py-24">
			<div class="mx-auto max-w-content px-6 lg:px-8">
				<div class="mb-10 max-w-xl">
					@eyebrow("The redesign")
					<h2 class="mt-3 font-display text-h3-display font-normal text-fc-obsidian">
						What it replaced.
					</h2>
				</div>
				<div class="grid gap-8 sm:grid-cols-2 sm:gap-10">
					@redesignPanel("Before", p.Redesign.Before, p.Redesign.BeforeCaption, p.Client+" website before the rebuild", false)
					@redesignPanel("After", p.Redesign.After, p.Redesign.AfterCaption, p.Client+" website after the rebuild", true)
				</div>
			</div>
		</section>
	}
	<!-- The work -->
	if len(p.Gallery) > 0 {
		<section class="bg-white py-20 sm:py-24">
			<div class="mx-auto max-w-content px-6 lg:px-8">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
					<div>
						@eyebrow("The work")
						<h2 class="mt-3 max-w-xl font-display text-h3-display font-normal text-fc-obsidian">
							A few pieces from the shop.
						</h2>
					</div>
					if p.LiveURL != "" {
						<a
							href={ templ.SafeURL(p.LiveURL + "/gallery") }
							target="_blank"
							rel="noopener"
							class="border-b-[1.5px] border-fc-ember-deep pb-[2px] text-ui font-medium uppercase text-fc-ember-deep transition hover:brightness-110"
						>
							See the full gallery &nearr;
						</a>
					}
				</div>
				<div class="gap-3 [column-count:2] md:[column-count:3]">
					for _, img := range p.Gallery {
						<img
							src={ img.Src }
							alt={ img.Alt }
							loading="lazy"
							class="mb-3 w-full break-inside-avoid rounded-[6px] border border-fc-ash object-cover transition duration-500 hover:brightness-105"
						/>
					}
				</div>
			</div>
		</section>
	}

	<!-- Story + Results -->
	<section class="bg-fc-obsidian py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 lg:px-8">
			<div class="flex flex-col gap-16 lg:flex-row lg:gap-20">
				<!-- Story -->
				<div class="flex-1">
					@eyebrowDark("The problem")
					<div class="mt-6 space-y-5 text-body text-fc-ash">
						for _, paragraph := range p.Story {
							<p>{ paragraph }</p>
						}
					</div>
				</div>
				<!-- Results -->
				if len(p.Results) > 0 {
					<div class="flex flex-col gap-6 sm:flex-row sm:gap-8 lg:w-[220px] lg:flex-col lg:gap-10">
						for _, r := range p.Results {
							<div>
								<div class="font-display text-h2-display font-semibold text-fc-chalk">
									{ r.Value }
									<span class="text-body-sm font-normal text-fc-ember">{ r.Unit }</span>
								</div>
								<div class="mt-1 text-eyebrow tracking-normal text-fc-ash">{ r.Label }</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</section>

	<!-- Quote -->
	if p.Quote != nil {
		<section class="bg-white py-16 sm:py-20">
			<div class="mx-auto max-w-content px-6 lg:px-8">
				<div class="flex items-start gap-6">
					if p.Quote.Portrait != "" {
						<img src={ p.Quote.Portrait } alt={ p.Quote.Attribution } class="hidden sm:block h-20 w-20 rounded-[6px] object-cover" />
					}
					<div class="max-w-2xl border-l-2 border-fc-ember-deep py-4 pl-6">
						<p class="font-display text-h4-display italic text-fc-obsidian">
							&ldquo;{ p.Quote.Text }&rdquo;
						</p>
						<p class="mt-3 text-eyebrow font-medium uppercase text-fc-slate">
							{ p.Quote.Attribution }
						</p>
					</div>
				</div>
			</div>
		</section>
	}

	<!-- Deliverables -->
	if len(p.Deliverables) > 0 {
		<section class="bg-fc-chalk py-20 sm:py-24">
			<div class="mx-auto max-w-content px-6 lg:px-8">
				<div class="max-w-2xl">
					@eyebrow("What we delivered")
					<ul class="mt-6 space-y-3">
						for _, d := range p.Deliverables {
							<li class="flex items-start gap-3 text-body-sm text-fc-flint">
								<span class="mt-[9px] h-[5px] w-[5px] shrink-0 rounded-full bg-fc-ember-deep"></span>
								<span>{ d }</span>
							</li>
						}
					</ul>
				</div>
			</div>
		</section>
	}

	<!-- Next Project -->
	if p.NextSlug != "" {
		<a
			href={ templ.SafeURL("/work/" + p.NextSlug) }
			class="group flex items-center justify-between border-t border-fc-ash bg-white px-6 py-8 transition hover:bg-fc-chalk lg:px-8"
		>
			<div class="mx-auto flex w-full max-w-content items-center justify-between">
				<div>
					<p class="text-eyebrow font-medium uppercase text-fc-slate">Next field report</p>
					<p class="mt-1 font-display text-h4-display text-fc-obsidian">{ p.NextClient }</p>
				</div>
				<span class="text-h4-display text-fc-slate transition group-hover:translate-x-1 group-hover:text-fc-ember-deep">&rarr;</span>
			</div>
		</a>
	}

	<!-- CTA -->
	<section class="bg-fc-obsidian py-20 sm:py-24">
		<div class="mx-auto max-w-content px-6 text-center lg:px-8">
			<h2 class="font-display text-h2-display font-normal text-fc-chalk">
				Have a similar project?
			</h2>
			<p class="mx-auto mt-4 max-w-md text-body text-fc-ash">
				Tell us what you're working on. We'll tell you whether we're the right fit.
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-6">
				<a
					href="/contact"
					class="rounded-[3px] bg-fc-ember px-[22px] py-[10px] text-ui font-medium uppercase text-fc-obsidian transition hover:brightness-110 active:scale-[0.97]"
				>
					Start a project
				</a>
				<a
					href="/work"
					class="border-b-[1.5px] border-fc-ember px-0 py-[10px] text-ui font-medium uppercase text-fc-ember transition hover:brightness-110 active:scale-[0.98]"
				>
					Back to all work &rarr;
				</a>
			</div>
		</div>
	</section>
}
