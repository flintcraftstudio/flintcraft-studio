package chiropractor

import (
	"github.com/firefly-software-mt/standard-template/internal/structdata"
	"github.com/firefly-software-mt/standard-template/internal/theme"
	"github.com/firefly-software-mt/standard-template/internal/ui"
)

// pageState carries per-request rendering context (route prefix, public origin,
// theme, and any intake form state for the no-JS fallback) through the page.
type pageState struct {
	prefix  string
	baseURL string
	theme   theme.Theme
	intake  *intakeState
}

// intakeState reflects a submitted intake form for the full-page (no-JS) path.
type intakeState struct {
	sub     submission
	errs    intakeErrors
	success bool
}

// Page is the demo's full single-scroll homepage. It owns its own <head>
// (Newsreader/DM Sans, JSON-LD, demo stylesheet) rather than reusing the
// marketing layout, because this is a distinct brand.
templ Page(c Content, st pageState) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Demo: keep the fictional site out of search so the /chiropractor-website-design landing page is the canonical ranking target. -->
			<meta name="robots" content="noindex, follow"/>
			<title>{ c.Business.LegalName } · Helena, MT</title>
			<meta name="description" content={ c.HeroSub + " Now accepting new patients in Helena, Montana." }/>
			<link rel="icon" href="/static/favicon/favicon.svg" type="image/svg+xml"/>
			@theme.Head(st.theme)
			if c.HeroImage != "" {
				<link
					rel="preload"
					as="image"
					href={ st.prefix + "/static/img/" + c.HeroImage + "-1120.webp" }
					imagesrcset={ st.prefix + "/static/img/" + c.HeroImage + "-600.webp 600w, " + st.prefix + "/static/img/" + c.HeroImage + "-1120.webp 1120w" }
					imagesizes={ heroSizes }
					fetchpriority="high"
				/>
			}
			@structdata.Script(c.jsonLD(st.baseURL))
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/alpine.min.js" defer></script>
		</head>
		<body>
			@ui.SkipLink("top", "Skip to content")
			@ui.DemoBar("/contact?ref=chiropractor-demo")
			@Announce(c)
			@Nav(c)
			<main id="top">
				@Hero(c, st.prefix)
				@TrustBand(c)
				@Reassure(c, st.prefix)
				@Expect(c)
				@Specialties(c)
				@Team(c, st.prefix)
				@Treatments(c)
				@Reviews(c)
				@Book(c, st)
				@Location(c)
			</main>
			@Footer(c)
			@celebrateToast()
			@revealScript()
			@celebrateScript()
		</body>
	</html>
}

// celebrateToast is the FlintCraft nudge shown after a successful booking — it
// turns the demo's peak moment into a soft pitch. Hidden until fcCelebrate()
// reveals it. (This is demo chrome, like the demo bar — it links to FlintCraft.)
templ celebrateToast() {
	<div id="fcToast" class="fc-toast" role="status" aria-live="polite" hidden>
		<div class="fc-toast__body">
			<strong>That's how easy booking feels on a FlintCraft site.</strong>
			<span>Want one like this for your practice? Let's talk about your new site.</span>
		</div>
		<a class="fc-toast__cta" href="/contact?ref=chiropractor-demo">Talk to FlintCraft &rarr;</a>
		<button class="fc-toast__x" type="button" aria-label="Dismiss" data-fc-toast-close>&times;</button>
	</div>
}

// celebrateScript fires a confetti burst + reveals the toast when the intake
// success state appears — covering both the htmx swap (htmx:afterSettle) and
// the no-JS full-page fallback (DOMContentLoaded). Confetti is skipped under
// prefers-reduced-motion; the toast still shows.
templ celebrateScript() {
	<script>
		(function () {
			var done = false;
			window.fcCelebrate = function () {
				if (done) return;
				done = true;
				var toast = document.getElementById('fcToast');
				if (toast) {
					toast.hidden = false;
					requestAnimationFrame(function () { toast.classList.add('is-in'); });
					setTimeout(function () {
						toast.classList.remove('is-in');
						setTimeout(function () { toast.hidden = true; }, 450);
					}, 11000);
				}
				var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (reduce) return;
				var colors = ['#1C4347', '#2F666B', '#6E8A5C', '#A9BE98', '#C7902E', '#EFEAD9'];
				var wrap = document.createElement('div');
				wrap.className = 'fc-confetti';
				wrap.setAttribute('aria-hidden', 'true');
				for (var i = 0; i < 90; i++) {
					var p = document.createElement('span');
					p.className = 'fc-confetti__bit';
					var sz = 6 + Math.random() * 7;
					p.style.left = (Math.random() * 100) + 'vw';
					p.style.width = sz + 'px';
					p.style.height = (sz * 0.5) + 'px';
					p.style.background = colors[i % colors.length];
					p.style.setProperty('--dx', ((Math.random() * 2 - 1) * 28) + 'vw');
					p.style.setProperty('--rot', (Math.random() * 900 - 450) + 'deg');
					p.style.animationDelay = (Math.random() * 0.35) + 's';
					p.style.animationDuration = (2.6 + Math.random() * 1.8) + 's';
					wrap.appendChild(p);
				}
				document.body.appendChild(wrap);
				setTimeout(function () { wrap.remove(); }, 5200);
			};
			function check() { if (document.querySelector('.intake__success')) window.fcCelebrate(); }
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', check);
			} else {
				check();
			}
			document.body.addEventListener('htmx:afterSettle', check);
			document.addEventListener('click', function (e) {
				if (e.target.closest && e.target.closest('[data-fc-toast-close]')) {
					var el = document.getElementById('fcToast');
					if (!el) return;
					el.classList.remove('is-in');
					setTimeout(function () { el.hidden = true; }, 450);
				}
			});
		})();
	</script>
}

// revealScript arms staggered scroll reveals for [data-reveal] containers. It's
// JS-armed: with no JS the content is fully visible (never hidden), and the
// reduced-motion override in the stylesheet shows steps instantly.
templ revealScript() {
	<script>
		(function () {
			var els = document.querySelectorAll('[data-reveal]');
			if (!els.length) return;
			els.forEach(function (el) { el.classList.add('reveal-armed'); });
			if (!('IntersectionObserver' in window)) {
				els.forEach(function (el) { el.classList.add('reveal-in'); });
				return;
			}
			var io = new IntersectionObserver(function (entries) {
				entries.forEach(function (e) {
					if (e.isIntersecting) { e.target.classList.add('reveal-in'); io.unobserve(e.target); }
				});
			}, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });
			els.forEach(function (el) { io.observe(el); });
		})();
	</script>
}

// Announce is the thin top strip.
templ Announce(c Content) {
	<div class="announce">
		<div class="announce__inner">
			<span><span class="dot" aria-hidden="true">●</span>&nbsp; Now accepting new patients</span>
			<span class="sep" aria-hidden="true">·</span>
			<span>Most insurance accepted</span>
			<span class="sep" aria-hidden="true">·</span>
			<a href={ telURL(c) }>@ui.IconPhone()<span>{ c.Business.PhoneLabel }</span></a>
		</div>
	</div>
}

// Nav is the sticky primary nav. Alpine handles the mobile drawer and the
// scroll shadow — the only client-side state on the page besides htmx.
templ Nav(c Content) {
	<header
		class="nav"
		x-data="{ open: false, scrolled: false }"
		x-bind:class="{ 'is-scrolled': scrolled }"
		x-on:scroll.window="scrolled = window.scrollY > 8"
	>
		<div class="container nav__inner">
			<a class="nav__brand" href="#top" style="color:var(--primary)">
				<span style="width:34px;height:34px;display:grid;place-items:center">@ui.IconArrowhead()</span>
				<span class="wm">{ c.Business.Name }</span>
			</a>
			<nav class="nav__links" aria-label="Primary">
				<a href="#treatments">Treatments</a>
				<a href="#team">Our Team</a>
				<a href="#reviews">Reviews</a>
				<a href="#new-patients">New Patients</a>
				<a href="#contact">Contact</a>
			</nav>
			<div class="nav__right">
				<a class="nav__phone" href={ telURL(c) }>@ui.IconPhone()<span>{ c.Business.PhoneLabel }</span></a>
				<a class="btn btn--primary" href="#book">Book Appointment</a>
				<button
					class="nav__menu-btn"
					type="button"
					aria-label="Open menu"
					x-bind:aria-expanded="open ? 'true' : 'false'"
					x-on:click="open = !open"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				</button>
			</div>
		</div>
		<div class="nav__mobile" x-bind:class="{ 'open': open }" x-on:click="open = false">
			<div class="container">
				<a href="#treatments">Treatments</a>
				<a href="#team">Our Team</a>
				<a href="#reviews">Reviews</a>
				<a href="#new-patients">New Patients</a>
				<a href="#contact">Contact</a>
				<a class="nav__phone" href={ telURL(c) } style="border-bottom:none">@ui.IconPhone()<span>{ c.Business.PhoneLabel }</span></a>
				<div class="mob-cta">
					<a class="btn btn--primary" href="#book">Book Appointment</a>
				</div>
			</div>
		</div>
	</header>
}

// Footer is the dark, comprehensive footer.
templ Footer(c Content) {
	<footer class="footer">
		<div class="container">
			<div class="footer__top">
				<div class="footer__brand">
					<a class="nav__brand" href="#top" style="color:var(--teal-300);margin-bottom:16px">
						<span style="width:40px;height:40px;display:grid;place-items:center">@ui.IconArrowhead()</span>
						<span class="wm" style="color:var(--ink-on-dark);font-size:24px">{ c.Business.Name }</span>
					</a>
					<p>Helena's home for feeling better.</p>
					<p class="blurb">Gentle, individualized chiropractic care in the heart of the Helena valley.</p>
				</div>
				<div>
					<h4>Care</h4>
					<ul>
						<li><a href="#specialties">Sports &amp; Performance</a></li>
						<li><a href="#specialties">Family &amp; Pediatric</a></li>
						<li><a href="#specialties">Auto &amp; Work Injury</a></li>
						<li><a href="#treatments">All Treatments</a></li>
					</ul>
				</div>
				<div>
					<h4>Practice</h4>
					<ul>
						<li><a href="#team">Our Team</a></li>
						<li><a href="#new-patients">New Patients</a></li>
						<li><a href="#reviews">Reviews</a></li>
						<li><a href="#book">Book Online</a></li>
					</ul>
				</div>
				<div>
					<h4>Visit</h4>
					<p class="footer__addr">
						<b>{ c.Business.Name }</b><br/>
						{ c.Business.Street }<br/>
						{ c.Business.Locality }, { c.Business.Region } { c.Business.PostalCode }<br/><br/>
						<a href={ telURL(c) }>{ c.Business.PhoneLabel }</a><br/>
						{ c.HoursSummary }
					</p>
				</div>
			</div>
			<div class="footer__hr"></div>
			<div class="footer__legal">
				<span>© 2026 { c.Business.LegalName }. All rights reserved.</span>
				<span>Privacy · Terms · Accessibility · Patient Rights</span>
			</div>
		</div>
	</footer>
}
